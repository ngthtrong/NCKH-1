  <diagram id="hinh_2_13_two_tier_caching" name="Hình 2.13 · Two-Tier Cache: đọc dữ liệu và admission">
    <mxGraphModel grid="1" gridSize="10" page="0" background="#ffffff" math="0" shadow="0" pageWidth="1200" pageHeight="1045">
