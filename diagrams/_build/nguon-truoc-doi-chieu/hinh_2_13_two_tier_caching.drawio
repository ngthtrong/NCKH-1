        <mxCell id="19" value="Không nhận vào cache ≠ bỏ request.&#10;W-TinyLFU của Caffeine không tự quyết định admission vào Redis L2." style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontFamily=Arial;fontColor=#213047;fontSize=16;fillColor=#F3F5F8;strokeColor=#8592A4;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="70" y="845" width="1060" height="80" as="geometry" />
        </mxCell>
        <mxCell id="20" value="Khóa của cả L1/L2 phải chứa tenant_id. Key prefix tránh trùng khóa nhưng không tự tạo quota RAM theo tenant.&#10;Nếu cần chống một tenant lấn cache: thêm phân vùng/quota có thực thi; kiểm tra bằng tải quét và đo hit rate/p99." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#213047;fontSize=16;fontSize=14;fontStyle=0;" vertex="1" parent="1">
