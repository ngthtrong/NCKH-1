        <mxCell id="3" value="L1 Caffeine (W-TinyLFU) → L2 Redis → DB. Cache miss hoặc từ chối admission vẫn phải phục vụ dữ liệu." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#213047;fontSize=16;fontSize=15;fontStyle=0;" vertex="1" parent="1">
