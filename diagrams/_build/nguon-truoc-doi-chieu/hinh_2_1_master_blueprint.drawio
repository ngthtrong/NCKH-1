        </mxCell>
        <mxCell id="26" value="Level 1–5 là hệ phân loại của báo cáo, khác với số tầng 1–9. VM và container là hai cơ chế triển khai khác nhau;&#10;không suy ra mức chia sẻ chỉ từ tên tầng. Khung tài nguyên ở các hình sau mới mang nghĩa Shared/Dedicated." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#213047;fontSize=16;fontSize=14;fontStyle=0;" vertex="1" parent="1">
