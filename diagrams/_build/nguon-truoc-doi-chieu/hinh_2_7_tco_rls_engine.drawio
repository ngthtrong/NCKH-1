        <mxCell id="reference-footer" value="RLS thực thi trong DBMS; policy gắn với bảng thuộc schema. App role không là superuser/BYPASSRLS; dùng ENABLE/FORCE RLS.&#10;Thiếu/rỗng tenant context → không đọc được hàng; WITH CHECK bảo vệ thao tác ghi. Không hiểu “kernel” là nhân hệ điều hành." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontColor=#213047;fontSize=14;fontStyle=0;">
          <mxGeometry x="30" y="1155.0" width="1119.0" height="100" as="geometry" />
