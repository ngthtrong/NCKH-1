        <mxCell id="subtitle" value="JVM minh họa: Gateway và Backend là hai process; ThreadLocal chỉ có hiệu lực trong process/thread tương ứng." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontColor=#213047;fontSize=16;fontSize=15;">
