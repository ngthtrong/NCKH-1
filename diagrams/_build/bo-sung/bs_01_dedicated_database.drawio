        </mxCell>
        <mxCell id="18" value="Khung VM riêng chứng minh mức cô lập được giả định trong hình. Chỉ khác port/process/thư mục chưa chứng minh cô lập vật lý.&#10;Shared App và Router vẫn là phụ thuộc dùng chung; cần kiểm soát quyền và tránh định tuyến sai tenant." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#213047;fontSize=16;fontSize=14;fontStyle=0;" vertex="1" parent="1">
