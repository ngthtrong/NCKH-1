        <mxCell id="3" value="Policy gắn với bảng trong schema (tầng 6); PostgreSQL engine (tầng 4) thực thi kiểm soát hàng." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#213047;fontSize=16;fontSize=15;fontStyle=0;" vertex="1" parent="1">
