        <mxCell id="19" value="Đánh giá thêm tải, quy mô, vùng triển khai và vận hành.&#10;Cell-Based là lựa chọn khi cần phân vùng sức chứa / phạm vi sự cố; không phải mặc định chỉ vì ngân sách cao." style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontFamily=Arial;fontColor=#213047;fontSize=16;fillColor=#F3F5F8;strokeColor=#8592A4;strokeWidth=1.6;" vertex="1" parent="1">
