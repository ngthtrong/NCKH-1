          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="21" value="Câu 1 phải dựa trên yêu cầu triển khai cụ thể: tên tiêu chuẩn tuân thủ hoặc BYOK không tự quyết định topology.&#10;Schema-per-Tenant là đòn bẩy dữ liệu bổ sung (Hình 2.4); không thay thế nhánh chạy mã tùy biến." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#213047;fontSize=16;fontSize=14;fontStyle=0;" vertex="1" parent="1">
