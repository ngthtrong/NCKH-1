        <mxCell id="subtitle" value="Hai request dùng lại cùng Conn #1; TenantContext chỉ được đặt trong transaction đã mở." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontColor=#213047;fontSize=16;fontSize=15;">
          <mxGeometry x="30" y="70" width="1020.0" height="50" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="UUID đuôi 0001 đại diện Tenant A; UUID đuôi 0002 đại diện Tenant B.&#10;SET LOCAL hết hiệu lực ở cuối transaction, khôi phục session trước đó; session không được mang tenant context tồn dư.&#10;RLS: NULLIF(current_setting('app.current_tenant_id', true), '')::uuid; thiếu/rỗng → không đọc được hàng." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Arial;fontColor=#213047;fontSize=16;fontSize=15;">
