<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" version="26.0.0">
  <diagram id="cloud-native-stack" name="NganXepCloudNative">
    <mxGraphModel dx="1200" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="580" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="HÌNH 1.5.3: MÔ HÌNH NGĂN XẾP CẬP NHẬT CHO KỶ NGUYÊN CLOUD-NATIVE" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#0f172a;fontFamily=Segoe UI,Helvetica,Arial;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="960" height="35" as="geometry" /></mxCell>
        <mxCell id="layer_L9" value="[Tầng 9] Application Instance (Thực thể ứng dụng)&#xa;Web API App, Worker Daemon, Microservices" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e40af;fontSize=11.5;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="75" width="540" height="42" as="geometry" /></mxCell>
        <mxCell id="layer_L8" value="[Tầng 8] Application Server (Máy chủ ứng dụng)&#xa;Kestrel, JVM, Node.js, Web Runtime Engine" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e40af;fontSize=11.5;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="123" width="540" height="42" as="geometry" /></mxCell>
        <mxCell id="layer_L7" value="[Tầng 7] Middleware (Phần mềm trung gian)&#xa;API Gateway, Redis Cache, Message Queue, Object Storage (S3)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontColor=#9a3412;fontSize=11.5;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="171" width="540" height="42" as="geometry" /></mxCell>
        <mxCell id="tag_L7" value="Hiệu chỉnh Cloud-Native: Chuyển sang Nét liền" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ea580c;strokeColor=#c2410c;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="layer_L7"><mxGeometry x="320" y="2" width="215" height="18" as="geometry" /></mxCell>
        <mxCell id="layer_L6" value="[Tầng 6] Database Schema (Lược đồ CSDL)&#xa;Multi-Schema, Shared Schema với RLS Filter" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#166534;fontSize=11.5;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="219" width="540" height="42" as="geometry" /></mxCell>
        <mxCell id="layer_L5" value="[Tầng 5] Database (Cơ sở dữ liệu)&#xa;Catalog CSDL, Instance Cơ sở dữ liệu vật lý / logic" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#166534;fontSize=11.5;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="267" width="540" height="42" as="geometry" /></mxCell>
        <mxCell id="layer_L4" value="[Tầng 4] Database Server (Máy chủ CSDL)&#xa;PostgreSQL Daemon, MySQL Server Engine" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#166534;fontSize=11.5;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="315" width="540" height="42" as="geometry" /></mxCell>
        <mxCell id="layer_L3" value="[Tầng 3] Operating System (Hệ điều hành)&#xa;Linux Kernel, cgroups, Namespaces" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=2;fontColor=#334155;fontSize=11.5;fontStyle=1;align=center;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="60" y="363" width="540" height="42" as="geometry" /></mxCell>
        <mxCell id="layer_L2" value="[Tầng 2] Virtual Machine (Máy ảo)&#xa;KVM, AWS Nitro, Hypervisor VM" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=2;fontColor=#334155;fontSize=11.5;fontStyle=1;align=center;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="60" y="411" width="540" height="42" as="geometry" /></mxCell>
        <mxCell id="layer_L1" value="[Tầng 1] Hardware (Phần cứng vật lý)&#xa;Bare-Metal Server Chassis, CPU, RAM, NVMe Storage" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=2;fontColor=#334155;fontSize=11.5;fontStyle=1;align=center;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="60" y="459" width="540" height="42" as="geometry" /></mxCell>
        <mxCell id="scope_analysis" value="PHẠM VI PHÂN TÍCH TÁCH / GỘP (NÉT LIỀN)&#xa;Sáu tầng trọng tâm phân tích các quyết định kiến trúc:&#xa;Database Server, Database, Schema, Middleware, App Server, Instance.&#xa;Thực thi trực tiếp ranh giới cô lập thuê bao B1–B4." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.5;fontColor=#1e40af;fontSize=10.5;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="630" y="75" width="380" height="125" as="geometry" /></mxCell>
        <mxCell id="scope_container" value="CHÚ THÍCH CONTAINERIZATION&#xa;Cơ chế cô lập cấp Hệ điều hành (Namespaces &amp; cgroups).&#xa;Chia sẻ nhân OS Kernel với máy chủ nền; có thể bố trí riêng&#xa;hoặc dùng chung tùy mô hình thiết kế.&#xa;Không xem là tầng độc lập hay tầng thứ 10." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=1.5;fontColor=#9a3412;fontSize=10.5;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="630" y="220" width="380" height="110" as="geometry" /></mxCell>
        <mxCell id="scope_infra" value="HẠ TẦNG NỀN &amp; MÔI TRƯỜNG THỰC THI (NÉT ĐỨT)&#xa;Ba tầng thấp: Hardware, Virtual Machine, Operating System.&#xa;Cung cấp tài nguyên tính toán và lưu trữ cơ bản." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#334155;fontSize=10.5;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="630" y="350" width="380" height="85" as="geometry" /></mxCell>
        <mxCell id="bracket_c" value="" style="edgeStyle=straight;html=1;strokeColor=#ea580c;strokeWidth=2;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="380" as="sourcePoint" /><mxPoint x="605" y="435" as="targetPoint" /><Array as="points"><mxPoint x="620" y="380" /><mxPoint x="620" y="435" /></Array></mxGeometry></mxCell>
        <mxCell id="bracket_c_conn" value="" style="edgeStyle=straight;html=1;strokeColor=#ea580c;strokeWidth=1.5;endArrow=block;endSize=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="275" as="sourcePoint" /><mxPoint x="620" y="400" as="targetPoint" /><Array as="points"><mxPoint x="620" y="275" /></Array></mxGeometry></mxCell>
        <mxCell id="legend_bar" value="QUY ƯỚC KÝ HIỆU:    ─── Nét liền (Tầng 4–9): Trọng tâm phân tích Tách/Gộp    |    - - - Nét đứt (Tầng 1–3): Hạ tầng nền    |    [Màu cam] Tầng 7 Middleware: Hiệu chỉnh Cloud-Native" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;fontColor=#1e293b;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="515" width="950" height="30" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
