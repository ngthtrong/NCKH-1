        <mxCell id="frame_53" value="HÌNH 5.3: KẾT QUẢ KIỂM ĐỊNH ĐỊNH DANH (KB-1), CÔ LẬP CSDL FAIL-CLOSED (KB-2) VÀ CHI PHÍ THỰC THI RLS" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E3A8A;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=top;startSize=35;" vertex="1" parent="1">
