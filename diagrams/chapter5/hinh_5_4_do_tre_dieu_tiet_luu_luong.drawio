        <mxCell id="p54_c" value="Panel c: Điều tiết Lưu lượng &amp; Telemetry CPU/RAM
(Chặn 92.66% bão tải &amp; Giải mã 94% CPU contention)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=12;fontStyle=1;align=center;verticalAlign=top;startSize=35;" vertex="1" parent="frame_54">
