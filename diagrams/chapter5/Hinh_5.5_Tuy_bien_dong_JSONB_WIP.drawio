<mxfile host="app.diagrams.net"><diagram name="Hình 5.5" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Hình 5.5. Quy trình tùy biến cấu hình động và kết quả kiểm chứng JSONB, WIP Strict" style="html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="20.0" y="10.0" width="1480.0" height="40.0" as="geometry"/></mxCell><mxCell id="n3" value="" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#CBD5E1;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="30.0" y="60.0" width="1460.0" height="330.0" as="geometry"/></mxCell><mxCell id="n4" value="Quy trình đổi cấu hình lúc chạy (không sửa mã nguồn, không triển khai lại)" style="html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="40.0" y="66.0" width="1440.0" height="28.0" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;1. Cập nhật cấu hình&lt;/b&gt;&lt;br&gt;Quản trị thuê bao đổi wipMode / WIP Limit / trường mở rộng qua /tenant-settings/kanban" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#DBEAFE;strokeColor=#475569;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55.0" y="130.0" width="208.0" height="210.0" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;2. Lưu vào CSDL&lt;/b&gt;&lt;br&gt;PostgreSQL ghi cấu hình riêng của thuê bao (FORCE RLS)" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#D1FAE5;strokeColor=#475569;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="293.0" y="130.0" width="208.0" height="210.0" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;3. Phát sự kiện&lt;/b&gt;&lt;br&gt;Publish thông báo thay đổi lên Redis Pub/Sub" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FEE2E2;strokeColor=#475569;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="531.0" y="130.0" width="208.0" height="210.0" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;4. Vô hiệu hóa đệm&lt;/b&gt;&lt;br&gt;Các node kanban-api xóa L1 Caffeine và L2 Redis của thuê bao" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FEF3C7;strokeColor=#475569;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="769.0" y="130.0" width="208.0" height="210.0" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;5. Nạp cấu hình mới&lt;/b&gt;&lt;br&gt;Yêu cầu kế tiếp đọc lại cấu hình từ CSDL, nạp lại vào đệm" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#E0E7FF;strokeColor=#475569;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1007.0" y="130.0" width="208.0" height="210.0" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;6. Áp dụng ngay&lt;/b&gt;&lt;br&gt;Thuê bao chạy quy tắc mới; các thuê bao khác không bị ảnh hưởng" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#BBF7D0;strokeColor=#475569;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1245.0" y="130.0" width="208.0" height="210.0" as="geometry"/></mxCell><mxCell id="n11" value="" style="html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n12" value="" style="html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n13" value="" style="html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n14" value="" style="html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n15" value="" style="html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n16" value="" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#CBD5E1;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="30.0" y="420.0" width="1460.0" height="460.0" as="geometry"/></mxCell><mxCell id="n17" value="Kết quả kiểm chứng định lượng (proposed_summary.json)" style="html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="40.0" y="426.0" width="1440.0" height="28.0" as="geometry"/></mxCell><mxCell id="n18" value="" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="60.0" y="470.0" width="430.0" height="380.0" as="geometry"/></mxCell><mxCell id="n19" value="19/19" style="html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=54;fontStyle=1;fontColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="60.0" y="490.0" width="430.0" height="90.0" as="geometry"/></mxCell><mxCell id="n20" value="HTTP 200" style="html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="60.0" y="580.0" width="430.0" height="34.0" as="geometry"/></mxCell><mxCell id="n21" value="GET /tenant-settings/kanban&lt;br&gt;Truy xuất cấu hình thuê bao" style="html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="80.0" y="630.0" width="390.0" height="90.0" as="geometry"/></mxCell><mxCell id="n22" value="" style="html=1;whiteSpace=wrap;fillColor=#2563EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x=