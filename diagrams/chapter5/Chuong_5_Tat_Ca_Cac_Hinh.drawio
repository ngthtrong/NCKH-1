        <mxCell id="docker_box" value="CỤM DOCKER COMPOSE ĐA THUÊ BAO (GHIM CỨNG HẠN MỨC CGROUPS)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=top;startSize=40;" vertex="1" parent="ec2_host">
