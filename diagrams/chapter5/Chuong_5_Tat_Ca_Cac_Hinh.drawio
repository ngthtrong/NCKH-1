  <diagram id="diag_ch5_2" name="Hình 5.2 · Bản đồ thiết kế thực nghiệm và ánh xạ KB-1 đến KB-4">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame_52" value="HÌNH 5.2: BẢN ĐỒ THIẾT KẾ THỰC NGHIỆM VÀ ÁNH XẠ CÁC KỊCH BẢN KIỂM ĐỊNH KB-1 ĐẾN KB-4" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E3A8A;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=top;startSize=35;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1360" height="720" as="geometry" />
        </mxCell>
        <mxCell id="col_kb1" value="KỊCH BẢN KB-1
Kiểm định Ranh giới Định danh" style="swimlane;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1E40AF;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=top;startSize=45;fontColor=#FFFFFF;fillColor2=#1E40AF;" vertex="1" parent="frame_52">
          <mxGeometry x="50" y="80" width="300" height="620" as="geometry" />
        </mxCell>
        <mxCell id="col_kb1_l1" value="K1: Phân giải Ngữ cảnh luồng
NFR-01: Toàn vẹn Ranh giới Định danh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E40AF;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="frame_52">
          <mxGeometry x="65" y="135" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="col_kb1_l2" value="MỤC TIÊU CỐT LÕI:
Xác thực token JWT tại biên, thiết lập ngữ cảnh luồng ThreadLocal bất biến và ngăn rò rỉ ngữ cảnh khi luân chuyển tải." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E40AF;strokeWidth=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="frame_52">
          <mxGeometry x="65" y="195" width="270" height="85" as="geometry" />
        </mxCell>
        <mxCell id="col_kb1_l3" value="KỊCH BẢN TIÊM LỖI:
• 500 req JWT thiếu/sai chữ ký
• 200 req tiêu đề Host lệch tenant
• 1.500 req luân chuyển trên hồ luồng Tomcat (60 threads)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E40AF;strokeWidth=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="frame_52">
          <mxGeometry x="65" y="290" width="270" height="105" as="geometry" />
        </mxCell>
        <mxCell id="col_kb1_l4" value="CƠ CHẾ KỸ THUẬT:
TenantContextFilter + JWT Parser
+ Khối lệnh try ... finally bắt buộc giải phóng ThreadLocal." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E40AF;strokeWidth=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="frame_52">
          <mxGeometry x="65" y="405" width="270" height="95" as="geometry" />
        </mxCell>
        <mxCell id="col_kb1_l5" value="KẾT QUẢ ĐẠT ĐƯỢC:
✓ 100% chặn HTTP 401 (500/500)
✓ 100% chặn HTTP 403 (200/200)
✓ 100% khớp X-Tenant-ID &amp; MDC
✓ 0% rò rỉ ngữ cảnh chéo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#1E40AF;strokeWidth=2;fontSize=10.5;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="frame_52">
          <mxGeometry x="65" y="510" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="col_kb2" value="KỊCH BẢN KB-2
Kiểm định Rào chắn CSDL &amp; Fail-Closed" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=top;startSize=45;fontColor=#FFFFFF;fillColor2=#047857;" vertex="1" parent="frame_52">
          <mxGeometry x="380" y="80" width="300" height="620" as="geometry" />
        </mxCell>
        <mxCell id="col_kb2_l1" value="K2: Cô lập CSDL cấp dòng &amp; Bộ đệm
NFR-02, NFR-03: Không rò rỉ, Phụ trội RLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="frame_52">
          <mxGeometry x="395" y="135" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="col_kb2_l2" value="MỤC TIÊU CỐT LÕI:
Bảo đảm an toàn dữ liệu tuyệt đối ở tầng lưu trữ dùng chung, kích hoạt Fail-Closed và định lượng chi phí vi mô của RLS." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="frame_52">
          <mxGeometry x="395" y="195" width="270" height="85" as="geometry" />
        </mxCell>
        <mxCell id="col_kb2_l3" value="KỊCH BẢN TIÊM LỖI:
• 200 câu SELECT cố tình bỏ WHERE
• 300 mẫu IDOR đoán UUID thẻ chéo
• 100 truy vấn cố tình bỏ SET LOCAL
• Microbenchmark 500 truy vấn đo RLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="frame_52">
          <mxGeometry x="395" y="290" width="270" height="105" as="geometry" />
        </mxCell>
        <mxCell id="col_kb2_l4" value="CƠ CHẾ KỸ THUẬT:
PostgreSQL FORCE ROW LEVEL SECURITY
+ Tài khoản NOBYPASSRLS
+ Biến phiên SET LOCAL app.tenant_id
+ Chỉ mục B-Tree dẫn đầu bởi tenant_id." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="frame_52">
          <mxGeometry x="395" y="405" width="270" height="95" as="geometry" />
        </mxCell>
        <mxCell id="col_kb2_l5" value="KẾT QUẢ ĐẠT ĐƯỢC:
✓ 0 bản ghi rò rỉ (0 leak)
✓ 100% chặn IDOR (404/403)
✓ Fail-Closed trả về rỗng (0 dòng)
✓ Độ trễ RLS vi mô: +0.45 ms (~36%)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#047857;strokeWidth=2;fontSize=10.5;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="frame_52">
          <mxGeometry x="395" y="510" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="col_kb3" value="KỊCH BẢN KB-3
Kháng Láng giềng Ồn ào &amp; Hiệu năng" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=top;startSize=45;fontColor=#FFFFFF;fillColor2=#B45309;" vertex="1" parent="frame_52">
          <mxGeometry x="710" y="80" width="300" height="620" as="geometry" />
        </mxCell>
        <mxCell id="col_kb3_l1" value="K3: Điều tiết Lưu lượng &amp; Đệm 2 tầng
NFR-04: Bảo toàn cam kết SLA &lt; 500 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="frame_52">
          <mxGeometry x="725" y="135" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="col_kb3_l2" value="MỤC TIÊU CỐT LÕI:
Dập tắt bão tải của Aggressor tại biên, bảo toàn độ trễ p50/p95 cho các tenant bình thường và giải tỏa áp lực cho CSDL." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="frame_52">
          <mxGeometry x="725" y="195" width="270" height="85" as="geometry" />
        </mxCell>
        <mxCell id="col_kb3_l3" value="KỊCH BẢN TIÊM LỖI:
• Aggressor phát tải 1.800–3.000 req/phút dồn dập (20 VUs)
• 4 tenant thông thường gửi tải hợp lệ (60 VUs)
• Khảo sát bóc tách 4 cấu hình kiểm soát" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="frame_52">
          <mxGeometry x="725" y="290" width="270" height="105" as="geometry" />
        </mxCell>
        <mxCell id="col_kb3_l4" value="CƠ CHẾ KỸ THUẬT:
Redis Token Bucket (1.200 req/min)
+ Bộ đệm 2 tầng: L1 Caffeine W-TinyLFU
+ L2 Redis Tenant-partitioned
+ Hồ kết nối HikariCP (max 25)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="frame_52">
          <mxGeometry x="725" y="405" width="270" height="95" as="geometry" />
        </mxCell>
        <mxCell id="col_kb3_l5" value="KẾT QUẢ ĐẠT ĐƯỢC:
✓ p50 giảm 88% (22.87–26.92 ms)
✓ p95 giảm 80% (242–276 ms &lt; 500ms)
✓ Chặn 16.423 req 429 (92.66% bão tải)
✓ Thông lượng: 327.56 RPS (+223%)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#B45309;strokeWidth=2;fontSize=10.5;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="frame_52">
          <mxGeometry x="725" y="510" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="col_kb4" value="KỊCH BẢN KB-4
Tùy biến Động 3 Lớp &amp; Đồng bộ" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7E22CE;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=top;startSize=45;fontColor=#FFFFFF;fillColor2=#7E22CE;" vertex="1" parent="frame_52">
          <mxGeometry x="1040" y="80" width="300" height="620" as="geometry" />
        </mxCell>
        <mxCell id="col_kb4_l1" value="K4: Động cơ Siêu dữ liệu &amp; Vòng đời
NFR-05, NFR-06: Tùy biến, Nhất quán đệm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E22CE;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="frame_52">
          <mxGeometry x="1055" y="135" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="col_kb4_l2" value="MỤC TIÊU CỐT LÕI:
Vận hành đồng thời các tổ chức có quy tắc nghiệp vụ đối lập trên 1 bộ mã nguồn, xác thực schema JSONB và đồng bộ hủy đệm." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E22CE;strokeWidth=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="frame_52">
          <mxGeometry x="1055" y="195" width="270" height="85" as="geometry" />
        </mxCell>
        <mxCell id="col_kb4_l3" value="KỊCH BẢN TIÊM LỖI:
• GET /tenant-settings/kanban (19 req)
• POST task customData JSONB (19 req)
• Di chuyển thẻ vi phạm WIP STRICT (limit=2, 19 req thử nghiệm)
• Quản trị viên đổi luật và bắn Pub/Sub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E22CE;strokeWidth=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="frame_52">
          <mxGeometry x="1055" y="290" width="270" height="105" as="geometry" />
        </mxCell>
        <mxCell id="col_kb4_l4" value="CƠ CHẾ KỸ THUẬT:
Động cơ siêu dữ liệu JSONB động
+ Spring Data JPA validation
+ Kênh Redis Pub/Sub tenant:config:invalidate
+ Nạp Lazy Load L1 Caffeine." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E22CE;strokeWidth=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="frame_52">
          <mxGeometry x="1055" y="405" width="270" height="95" as="geometry" />
        </mxCell>
        <mxCell id="col_kb4_l5" value="KẾT QUẢ ĐẠT ĐƯỢC:
✓ 19/19 GET nạp config đạt 200 OK
✓ 19/19 POST JSONB đạt 201 Created
✓ 17/19 lượt vượt WIP bị chặn 422 (89.5%)
✓ Lan truyền hủy đệm Pub/Sub: 2.45 ms." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#7E22CE;strokeWidth=2;fontSize=10.5;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="frame_52">
          <mxGeometry x="1055" y="510" width="270" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="diag_ch5_3" name="Hình 5.3 · Kết quả kiểm định định danh, cô lập CSDL và chi phí RLS">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame_53" value="HÌNH 5.3: KẾT QUẢ KIỂM ĐỊNH ĐỊNH DANH (KB-1), CÔ LẬP CSDL FAIL-CLOSED (KB-2) VÀ CHI PHÍ THỰC THI RLS" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E3A8A;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=top;startSize=35;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1360" height="680" as="geometry" />
        </mxCell>
        <mxCell id="panel_a" value="Panel a: Kiểm định ranh giới ngữ cảnh luồng (KB-1)
(Mặt phẳng Dữ liệu &amp; Hồ luồng Tomcat)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontSize=12;fontStyle=1;align=center;verticalAlign=top;startSize=35;" vertex="1" parent="frame_53">
          <mxGeometry x="50" y="75" width="400" height="590" as="geometry" />
        </mxCell>
        <mxCell id="pa_c1" value="Tiêm lỗi JWT hỏng / Không chữ ký
• Số mẫu thử nghiệm: 500 yêu cầu
• Kết quả: 500/500 bị chặn đứng ngay tại biên
• Mã phản hồi: HTTP 401 Unauthorized
• Tỷ lệ phòng vệ đúng: 100.0% (0 rò rỉ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="frame_53">
          <mxGeometry x="70" y="130" width="360" height="95" as="geometry" />
        </mxCell>
        <mxCell id="pa_c2" value="Tiêm lỗi Host Header sai lệch định danh
• Số mẫu thử nghiệm: 200 yêu cầu
• Kết quả: 200/200 bị từ chối truy cập
• Mã phản hồi: HTTP 403 Forbidden
• Tỷ lệ phòng vệ đúng: 100.0% (0 rò rỉ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="frame_53">
          <mxGeometry x="70" y="245" width="360" height="95" as="geometry" />
        </mxCell>
        <mxCell id="pa_c3" value="Tải luân chuyển trên hồ luồng Tomcat (60 threads)
• Áp lực tải: 1.500 yêu cầu đan xen từ 5 nhóm tenant
• Kiểm tra khối try ... finally giải phóng ThreadLocal
• Tỷ lệ khớp tenant_id yêu cầu, tiêu đề X-Tenant-ID
  và nhãn MDC trong nhật ký: 100.0% (1.500 / 1.500)
• Tỷ lệ nhiễm bẩn ngữ cảnh luồng: 0.0% Tuyệt đối" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="frame_53">
          <mxGeometry x="70" y="360" width="360" height="130" as="geometry" />
        </mxCell>
        <mxCell id="pa_sum" value="KẾT LUẬN PANEL A: Cơ chế phòng thủ biên kết hợp ThreadLocal try/finally bảo đảm ranh giới ngữ cảnh an toàn 100%." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1;fontSize=10.5;fontStyle=1;align=center;" vertex="1" parent="frame_53">
          <mxGeometry x="70" y="510" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="panel_b" value="Panel b: Rào chắn CSDL Fail-Closed (KB-2)
(PostgreSQL 16 FORCE RLS &amp; NOBYPASSRLS)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontSize=12;fontStyle=1;align=center;verticalAlign=top;startSize=35;" vertex="1" parent="frame_53">
          <mxGeometry x="480" y="75" width="420" height="590" as="geometry" />
        </mxCell>
        <mxCell id="pb_c1" value="Truy vấn cố tình bỏ mệnh đề WHERE tenant_id
• Câu lệnh: SELECT * FROM cards;
• Số mẫu tiêm lỗi: 200 truy vấn
• Kết quả: FORCE RLS tự động chèn bộ lọc cấp nhân
• Số bản ghi rò rỉ: 0 bản ghi (0 leak tuyệt đối)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#047857;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="frame_53">
          <mxGeometry x="505" y="130" width="370" height="95" as="geometry" />
        </mxCell>
        <mxCell id="pb_c2" value="Tấn công IDOR đoán UUID thẻ chéo tenant
• Kịch bản: t-acme gọi API với UUID thuộc t-lotus
• Số mẫu thử nghiệm: 300 lần thử
• Kết quả: 300/300 bị vô hiệu hóa
• Mã phản hồi: HTTP 404 Not Found hoặc 403 Forbidden
• Tỷ lệ ngăn chặn: 100.0% (0 dữ liệu rò rỉ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#047857;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="frame_53">
          <mxGeometry x="505" y="245" width="370" height="105" as="geometry" />
        </mxCell>
        <mxCell id="pb_c3" value="Truy vấn HikariCP bị cố tình bỏ SET LOCAL
• Kịch bản: Không tiêm biến phiên SET LOCAL app.tenant_id
• Số mẫu kiểm thử: 100 truy vấn đối chứng
• Kết quả: Cơ chế Fail-Closed kích hoạt an toàn mặc định
• Dữ liệu trả về: Tập kết quả rỗng (0 dòng) | 0% rò rỉ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="frame_53">
          <mxGeometry x="505" y="370" width="370" height="95" as="geometry" />
        </mxCell>
        <mxCell id="pb_sum" value="KẾT LUẬN PANEL B: Cơ chế Fail-Closed bảo vệ dữ liệu thành công ngay cả khi lập trình viên bỏ sót WHERE hoặc bị tấn công IDOR." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1;fontSize=10.5;fontStyle=1;align=center;" vertex="1" parent="frame_53">
          <mxGeometry x="505" y="510" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="panel_c" value="Panel c: Chi phí Vi mô Thực thi RLS
(Đo lường qua EXPLAIN ANALYZE, N=500 mẫu)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=12;fontStyle=1;align=center;verticalAlign=top;startSize=35;" vertex="1" parent="frame_53">
          <mxGeometry x="930" y="75" width="420" height="590" as="geometry" />
        </mxCell>
        <mxCell id="pc_bar1" value="TRẠNG THÁI CƠ SỞ (TẮT RLS):
Độ trễ trung bình: 1.25 ± 0.32 ms
(Chỉ lọc WHERE thủ công ở tầng ứng dụng)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#475569;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="frame_53">
          <mxGeometry x="960" y="140" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pc_bar2" value="TRẠNG THÁI BẬT ĐẦY ĐỦ RLS (ĐỀ XUẤT):
Độ trễ trung bình: 1.70 ± 0.41 ms
(Bật SET LOCAL app.tenant_id + FORCE RLS hai lớp)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDD6FE;strokeColor=#6D28D9;strokeWidth=2;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="frame_53">
          <mxGeometry x="960" y="220" width="360" height="65" as="geometry" />
        </mxCell>
        <mxCell id="pc_delta" value="PHỤ TRỘI ĐỘ TRỄ VI MÔ:
Δ = +0.45 ms (~36% trong microbenchmark)
• Tối ưu hóa bởi chỉ mục tổ hợp B-Tree: (tenant_id, id)
• Hoàn toàn không gây nút thắt cổ chai hệ thống
• Thỏa mãn ngưỡng NFR-03 về chi phí bảo mật" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="frame_53">
          <mxGeometry x="960" y="310" width="360" height="105" as="geometry" />
        </mxCell>
        <mxCell id="pc_cache" value="PHÂN VÙNG BỘ NHỚ ĐỆM (KB-2.6):
• Kiểm tra tiền tố khóa: tenant:{tenant_id}:*
• 300 lần thử nghiệm thu hồi và kiểm tra chéo
• Kết quả: Cách ly hoàn toàn, 0 rò rỉ khóa giữa các tenant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="frame_53">
          <mxGeometry x="960" y="435" width="360" height="85" as="geometry" />
        </mxCell>
        <mxCell id="pc_sum" value="KẾT LUẬN PANEL C: Chi phí bảo mật RLS được giữ ở mức vi mô rất nhỏ (+0.45 ms) và thỏa mãn NFR-03." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1;fontSize=10.5;fontStyle=1;align=center;" vertex="1" parent="frame_53">
          <mxGeometry x="960" y="540" width="360" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
