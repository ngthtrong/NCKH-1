        PostgresDB[("Shared PostgreSQL\n(Ép buộc RLS + SET LOCAL)")]
    end


    Ingress --> ContextFilter
    AppLogic --> RedisCache & PostgresDB


    style App_Tier fill:#e1f5fe,stroke:#0288d1,stroke-width:2px
