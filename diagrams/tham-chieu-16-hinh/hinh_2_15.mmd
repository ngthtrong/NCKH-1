graph TD
    ClientReq[Yêu cầu Đọc Dữ liệu] --> L1Filter{"L1 Cache (Caffeine)\nThuật toán W-TinyLFU"}
    
    L1Filter -- "Hit" --> ReturnL1[Trả về kết quả tức thời]
    L1Filter -- "Miss: Truy vấn Quét (Cold Data)" --> CountMinSketch{"Count-Min Sketch Filter\n(Tần suất dự đoán thấp?)"}
    
    CountMinSketch -- "Tần suất thấp" --> DiscardCold[Không cho nạp vào Cache chính / Bỏ qua]
    CountMinSketch -- "Tần suất cao (Hot Data)" --> L2Redis[("L2 Cache (Redis Cluster)\nKey: 'tenant:id:key'")]
    
    L2Redis -- "Miss" --> FetchDB[(PostgreSQL RLS Database)]
    FetchDB --> FeedL1[Nạp vào L1]


    style L1Filter fill:#e1f5fe,stroke:#0288d1,stroke-width:2px
    style CountMinSketch fill:#fff9c4,stroke:#fbc02d,stroke-width:2px
    style L2Redis fill:#fff3e0,stroke:#f57c00,stroke-width:2px
    style FetchDB fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
