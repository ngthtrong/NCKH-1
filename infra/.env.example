# Local development only. Copy this file to infra/.env and replace every
# `change-me` value. Never commit infra/.env or production credentials.
COMPOSE_PROJECT_NAME=saas-research

POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me-postgres-admin

CONTROL_DB_NAME=control_db
CONTROL_DB_URL=jdbc:postgresql://postgres:5432/control_db
CONTROL_DB_USER=control_api
CONTROL_DB_PASSWORD=change-me-control-api

POOL_DB_NAME=pool_db
POOL_DB_URL=jdbc:postgresql://postgres:5432/pool_db
POOL_DB_USER=pool_api
POOL_DB_PASSWORD=change-me-pool-api

# This account is used only by the worker/provisioner and migration process.
# The API container never receives these credentials.
PROVISIONER_DB_USER=saas_provisioner
PROVISIONER_DB_PASSWORD=change-me-provisioner
PROVISIONING_LEASE_DURATION=PT10M
# DDL-only control-plane migration role; it cannot create databases or roles.
MIGRATION_DB_USER=control_migrator
MIGRATION_DB_PASSWORD=change-me-control-migrator
SILO_DB_HOST=postgres
SILO_DB_PORT=5432
SILO_DB_PREFIX=tenant_

# Development key only. Production must inject a random value from a secret
# manager. The application rejects values shorter than 32 characters.
JWT_SECRET=change-me-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=PT10M
REFRESH_TOKEN_TTL=P7D
PLACEMENT_ENCRYPTION_KEY=change-me-placement-encryption-key-32-bytes
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook-secret
RESOURCE_SIGNING_SECRET=change-me-resource-signing-secret-32-bytes

MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-04-16T18-13-26Z
MINIO_ROOT_USER=local-minio-admin
MINIO_ROOT_PASSWORD=change-me-minio-root
MINIO_APP_ACCESS_KEY=saas-local-app
MINIO_APP_SECRET_KEY=change-me-minio-app-secret
MINIO_BUCKET=tenant-resources
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

MAILPIT_IMAGE=axllent/mailpit:v1.30.0
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

PROMETHEUS_IMAGE=prom/prometheus:v3.5.5
PROMETHEUS_PORT=9090
GRAFANA_IMAGE=grafana/grafana:13.1.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin
CADDY_IMAGE=caddy:2.11.4-alpine
HTTP_PORT=8080

PAYMENT_PROVIDER=fake
PUBLIC_ACCOUNTS_URL=http://accounts.localhost:8080
LOG_LEVEL=INFO
DEMO_DATA_ENABLED=true
DEMO_OWNER_EMAIL=owner@example.test
DEMO_OWNER_PASSWORD=ChangeMe123!
