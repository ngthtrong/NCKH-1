  "narrative": {
    "northStar": "The Working Workspace",
    "overview": "This records the incumbent blue and white MUI application, scoped to the organization chooser, project list, project overview, and application shell. It is a source-derived record of a narrow refinement, not a new product identity. Readable Vietnamese text, clear status, and usable content width guide the interface.\n\nOrganization identity leads to projects; project identity and progress lead to boards. White bordered surfaces organize real names, counts, roles, and actions without requiring decorative imagery.",
    "keyCharacteristics": [
      "Locally served Vietnamese typography.",
      "Blue actions, restrained borders, white working surfaces.",
      "Fluid content with a compact supporting column.",
      "Explicit status labels and responsive rows."
    ],
    "rules": [
      {
        "name": "The Labeled Status Rule",
        "body": "Status must remain readable as text alongside its semantic color.",
        "section": "colors"
      },
      {
        "name": "The Vietnamese Reading Rule",
        "body": "Preserve local font loading and the observed body line height when extending these workspaces.",
        "section": "typography"
      },
      {
        "name": "The Useful Width Rule",
        "body": "Let the primary project column grow with the available shell width, and collapse the supporting column before it compresses the work.",
        "section": "layout"
      }
    ],
    "dos": [
      "**Do** retain readable Vietnamese labels, local fonts, and natural-case actions.",
      "**Do** show identity, status, and an open action together in organization rows.",
      "**Do** keep project progress and board access prominent in project overview.",
      "**Do** preserve responsive stacking and flexible project width."
    ],
    "donts": [
      "**Don't** use color as the only status signal.",
      "**Don't** copy pre-existing uppercase eyebrows into new workspace headers.",
      "**Don't** treat legacy decorative gradients as required workspace styling."
    ]
  }
