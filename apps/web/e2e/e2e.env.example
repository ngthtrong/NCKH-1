# Non-sensitive local topology. Override these URLs for another environment.
E2E_ACCOUNTS_URL=http://accounts.localhost:8080
# Loopback address used by Playwright's Node HTTP client; the test supplies
# each tenant hostname separately through the Host header.
E2E_GATEWAY_URL=http://127.0.0.1:8080
E2E_POOL_TENANT_SLUG=pool-demo
E2E_POOL_TENANT_URL=http://pool-demo.localhost:8080
E2E_SILO_TENANT_SLUG=silo-demo
E2E_SILO_TENANT_URL=http://silo-demo.localhost:8080

# Use the owner configured by the local seed. Do not commit the real password.
E2E_OWNER_EMAIL=replace-with-local-owner-email
E2E_OWNER_PASSWORD=replace-with-local-owner-password
