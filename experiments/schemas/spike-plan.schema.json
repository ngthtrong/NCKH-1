{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/saas-research/spike-plan.schema.json",
  "title": "Pre-registered P2 spike protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_kind",
    "spike_id",
    "adr",
    "decision",
    "candidates",
    "placements",
    "minimum_replicates",
    "required_cases",
    "mandatory_pass_cases",
    "required_artifact_kinds",
    "elimination_artifact_kinds",
    "measurements",
    "eliminate_if",
    "elimination_triggers",
    "rubric"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "data_kind": {"const": "spike_protocol"},
    "spike_id": {"type": "string", "minLength": 1},
    "adr": {"type": "string", "minLength": 1},
    "decision": {"const": "PENDING_DATA"},
    "candidates": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "placements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "minimum_replicates": {"type": "integer", "minimum": 1},
    "required_cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "mandatory_pass_cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "required_artifact_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "elimination_artifact_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "eliminate_if": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "elimination_triggers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "credential_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "required"],
      "properties": {
        "status": {"const": "PENDING_DATA"},
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "rubric": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "weight_percent"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "weight_percent": {
            "type": ["number", "null"],
            "exclusiveMinimum": 0,
            "maximum": 100
          }
        }
      }
    }
  }
}
