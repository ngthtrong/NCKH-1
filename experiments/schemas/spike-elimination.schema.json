{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/saas-research/spike-elimination.schema.json",
  "title": "Checksum-backed P2 candidate elimination evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_kind",
    "spike_id",
    "elimination_id",
    "candidate",
    "placement",
    "status",
    "reason",
    "observed_at_utc",
    "source",
    "environment",
    "case_results",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "data_kind": {"const": "spike_candidate_elimination"},
    "spike_id": {"type": "string", "minLength": 1},
    "elimination_id": {"type": "string", "minLength": 1},
    "candidate": {"type": "string", "minLength": 1},
    "placement": {"type": "string", "minLength": 1},
    "status": {"const": "eliminated"},
    "reason": {"type": "string", "minLength": 1},
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_commit", "git_dirty"],
      "properties": {
        "git_commit": {"type": "string", "pattern": "^(?:[A-Fa-f0-9]{40}|[A-Fa-f0-9]{64})$"},
        "git_dirty": {"const": false}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "postgresql_version", "cpu", "memory_bytes"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "postgresql_version": {"type": "string", "minLength": 1},
        "cpu": {"type": "string", "minLength": 1},
        "memory_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "case_results": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"enum": ["PASS", "FAIL"]}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
        }
      }
    }
  }
}
